# API
VITE_API_URL=https://api.pokeslide-internal.com/v1

# App
VITE_APP_NAME=Pokeslide Internal Platform
VITE_APP_VERSION=1.0.0

# Auth
VITE_TOKEN_KEY=pks_access_token

# Dev tools
VITE_ENABLE_QUERY_DEVTOOLS=false

# Dev auth mock — enabled by default in `npm run dev`; set to false to hit real API
VITE_USE_AUTH_MOCK=true

# Production Express server (npm run server / npm start)
PORT=3000
API_PROXY_TARGET=https://api.pokeslide-internal.com
API_PROXY_PATH=/v1

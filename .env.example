# API
# Production / remote: https://api.pokeslide-internal.com/v1
# Local ps-be:         http://localhost:8080/api/v1
VITE_API_URL=https://api.pokeslide-internal.com/v1

# App
VITE_APP_NAME=Pokeslide Internal Platform
VITE_APP_VERSION=1.0.0

# Auth
VITE_TOKEN_KEY=pks_access_token

# Dev tools
VITE_ENABLE_QUERY_DEVTOOLS=false
# Show test account shortcuts outside the Vite dev server.
# VITE_SHOW_TEST_ACCOUNTS=true

# Mock data is opt-in only (default: real API). Uncomment to bypass backend in dev:
# VITE_USE_AUTH_MOCK=true
# VITE_USE_USERS_MOCK=true
# VITE_USE_PROJECTS_MOCK=true
# VITE_USE_TRACKER_MOCK=true
# VITE_USE_TASKS_MOCK=true
# VITE_USE_TITLES_MOCK=true
# VITE_USE_TASK_SCORES_MOCK=true
# VITE_USE_CAPACITY_MOCK=true

# Production Express server (npm run server / npm start)
PORT=3000
API_PROXY_TARGET=https://api.pokeslide-internal.com
API_PROXY_PATH=/v1

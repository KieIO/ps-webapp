{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/create-task-flow",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/on-time-rate",
      "destination": "/on-time",
      "permanent": true
    },
    {
      "source": "/overtime-flow",
      "destination": "/overtime",
      "permanent": true
    },
    {
      "source": "/leave-flow",
      "destination": "/leave",
      "permanent": true
    },
    {
      "source": "/revision-flow",
      "destination": "/revision",
      "permanent": true
    }
  ]
}
